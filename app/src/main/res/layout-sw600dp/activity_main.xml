<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg_primary">

    <!-- Side Navigation for Tablets -->
    <LinearLayout
        android:layout_width="80dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg_secondary"
        android:paddingTop="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FF"
            android:textColor="@color/gold"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <ImageView
            android:id="@+id/nav_dashboard"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_dashboard"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/nav_item_bg"
            android:contentDescription="Dashboard" />

        <ImageView
            android:id="@+id/nav_apps"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_apps"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="Apps" />

        <ImageView
            android:id="@+id/nav_youtube"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_youtube"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="YouTube" />

        <ImageView
            android:id="@+id/nav_websites"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_web"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="Sites" />

        <ImageView
            android:id="@+id/nav_timer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_timer"
            android:padding="12dp"
            android:contentDescription="Timer" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

</LinearLayout>
